-- lib-http-middleware: modules this package provides (entry defaults to
-- src/index.hnl; N modules resolve to src/<name>/index.hnl).
{ modules: ["http-middleware"], name: "http-middleware", description: "Onion-style HTTP middleware pipeline for handl servers: (ctx, next) ~> {resp, state} steps over explicit {req, state} context, chain/pipeline folding, CORS, logger, request-id, session, auth, CSRF and body-limit middleware.", license: "MIT", keywords: ["http", "middleware", "serve", "cors", "session", "auth", "stdlib", "handl"], homepage: "https://github.com/handl-lang/lib-http-middleware" }
